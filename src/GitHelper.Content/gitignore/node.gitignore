# Files git should leave alone, for a Node project.

# Installed dependencies. Huge, and rebuilt by `npm install` from package.json.
node_modules/

# Build output.
dist/
build/
.next/
out/

# Secrets. Never commit these.
.env
.env.*

# Logs.
npm-debug.log*
yarn-error.log*
*.log

# Editor settings and operating system junk.
.vscode/
.idea/
.DS_Store
Thumbs.db
