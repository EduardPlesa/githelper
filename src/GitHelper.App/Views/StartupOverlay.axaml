<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitHelper.App.ViewModels"
             x:Class="GitHelper.App.Views.StartupOverlay"
             x:DataType="vm:StartupViewModel">
  <Border Background="{DynamicResource SystemRegionBrush}"
          CornerRadius="8"
          Padding="28"
          MaxWidth="560"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
    <StackPanel Spacing="16">

      <TextBlock Text="GitHelper" FontSize="22" FontWeight="Bold" />

      <!-- Running the environment check. -->
      <TextBlock IsVisible="{Binding IsChecking}" Text="Checking your setup…" Opacity="0.7" />

      <!-- Git is not installed: nothing else can work, so no picker is offered. -->
      <StackPanel Spacing="10" IsVisible="{Binding IsGitMissing}">
        <TextBlock Text="Git is not installed" FontWeight="Bold" />
        <TextBlock Text="{Binding BlockingMessage}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding BlockingFixHint}" TextWrapping="Wrap" Opacity="0.8" />
      </StackPanel>

      <!-- The folder is not a repository yet. Formerly a dead-end error; now the entry point. -->
      <StackPanel Spacing="10" IsVisible="{Binding IsOfferingInit}">
        <TextBlock Text="Not a git project yet" FontWeight="Bold" />
        <TextBlock Text="{Binding PendingFolderSummary}" TextWrapping="Wrap" />
        <TextBlock TextWrapping="Wrap" Opacity="0.8"
                   Text="Git keeps its history in a hidden .git folder, and there is not one here yet." />
        <Button Content="Start tracking this folder"
                Command="{Binding StartTrackingCommand}"
                HorizontalAlignment="Left" />
        <Button Content="Choose a different folder"
                Command="{Binding BrowseCommand}"
                HorizontalAlignment="Left" />
      </StackPanel>

      <!-- Normal case: browse, or pick something recent. -->
      <StackPanel Spacing="14" IsVisible="{Binding IsAwaitingChoice}">

        <TextBlock Text="Open a folder to get started." TextWrapping="Wrap" />

        <Button Content="Open folder…"
                Command="{Binding BrowseCommand}"
                HorizontalAlignment="Left" />

        <StackPanel Spacing="6" IsVisible="{Binding HasRecents}">
          <TextBlock Text="Recent projects" FontWeight="Bold" />
          <ItemsControl Name="RecentsHost" ItemsSource="{Binding Recents}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RecentRepoViewModel">
                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                  <Button Command="{Binding OpenCommand}"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Left">
                    <StackPanel Spacing="1">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding FullPath}" FontSize="11" Opacity="0.6"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Button>
                  <Button Grid.Column="1" Content="✕"
                          Command="{Binding RemoveCommand}"
                          ToolTip.Tip="Remove from this list"
                          Margin="6,0,0,0" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- A name and an email only. Never a password or token — the identity is the
             label stamped on commits, not a login. -->
        <StackPanel Spacing="8" IsVisible="{Binding IdentityPromptNeeded}">
          <TextBlock Text="Set your name for commits" FontWeight="Bold" />
          <TextBlock TextWrapping="Wrap" Opacity="0.8"
                     Text="Every commit records who made it. Setting this now avoids a confusing failure on your first commit. This is just a label — it is not an account, and no password is involved." />
          <TextBox Name="IdentityNameBox" Text="{Binding IdentityName, Mode=TwoWay}" Watermark="Your name" />
          <TextBox Name="IdentityEmailBox" Text="{Binding IdentityEmail, Mode=TwoWay}" Watermark="you@example.com" />
          <Button Content="Save to git"
                  Command="{Binding SaveIdentityCommand}"
                  HorizontalAlignment="Left" />
          <TextBlock IsVisible="{Binding HasIdentitySaveError}"
                     Text="{Binding IdentitySaveError}"
                     TextWrapping="Wrap" />
        </StackPanel>

      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
