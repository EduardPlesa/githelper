# Files git should leave alone, for a Java project.

# Compiled classes and build output.
*.class
target/
build/
out/

# Compiled jars are build output too, but the Gradle wrapper jar is the
# exception: it is committed so the wrapper can bootstrap a build on a
# machine that doesn't have Gradle installed yet.
*.jar
!gradle/wrapper/gradle-wrapper.jar

# Gradle's local working directory.
.gradle/

# Secrets. Never commit these.
.env
.env.*
*.jks

# Editor settings and operating system junk.
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db
